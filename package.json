{
  "$schema": "https://www.schemastore.org/package.json",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "fixtures:worldgen": "tsx scripts/dump-worldgen-fixtures.ts",
    "fixtures:protocol": "tsx scripts/dump-protocol-fixtures.ts",
    "fixtures": "npm run fixtures:worldgen && npm run fixtures:protocol && npm run fixtures:physics",
    "fixtures:physics": "tsx scripts/dump-physics-fixtures.ts"
  },
  "dependencies": {
    "@inertiajs/react": "^2.0.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "msgpackr": "^2.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.186.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "laravel-vite-plugin": "^3.1",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  }
}
