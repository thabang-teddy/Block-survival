<!--
  WinSW service definition for the Block Survival PC host (docs/pc-host-research.md §5.2).
  Put WinSW-x64.exe next to this file, renamed to pc-host-service.exe, then run
  `pc-host-service.exe install` once from an administrator prompt.

  The service starts with Windows (no login needed) and runs `pc-host service`: one
  worker process per world in config.json (docs/pc-host-research.md §8) and the control
  API on 127.0.0.1 that the Block Survival Host app uses to start and stop each world.
  Stopping the service (an update, a reboot, `pc-host-service.exe stop`) sends Ctrl+C:
  every world saves and tells the site it is restarting, so players stay paused. A world
  that crashes is started again by the service; a service crash exits non-zero and WinSW
  starts it again.

  The Block Survival Host installer writes its own copy of this file, with PC_HOST_HOME
  pointing at %ProgramData%\BlockSurvivalHost. Without it, config.json, control.key and
  logs\ live next to this file.
-->
<service>
  <id>block-survival-pc-host</id>
  <name>Block Survival PC host</name>
  <description>Hosts Block Survival global worlds for the site.</description>
  <executable>%BASE%\node.exe</executable>
  <arguments>"%BASE%\dist\pc-host.mjs" service</arguments>
  <workingdirectory>%BASE%</workingdirectory>
  <startmode>Automatic</startmode>
  <delayedAutoStart>true</delayedAutoStart>
  <onfailure action="restart" delay="10 sec"/>
  <onfailure action="restart" delay="30 sec"/>
  <onfailure action="restart" delay="2 min"/>
  <resetfailure>1 hour</resetfailure>
  <!-- time for every world to save and send its last heartbeat before Windows gives up -->
  <stoptimeout>30 sec</stoptimeout>
  <log mode="roll-by-size">
    <sizeThreshold>5120</sizeThreshold>
    <keepFiles>3</keepFiles>
  </log>
</service>
