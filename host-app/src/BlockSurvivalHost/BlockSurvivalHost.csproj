<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- the tray icon is WinForms' NotifyIcon -->
    <UseWindowsForms>true</UseWindowsForms>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>BlockSurvivalHost</AssemblyName>
    <Product>Block Survival Host</Product>
    <Company>Block Survival</Company>
    <Version>1.0.0</Version>
    <ApplicationIcon>Assets\host.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BlockSurvivalHost.Core\BlockSurvivalHost.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\host.ico" />
  </ItemGroup>

</Project>
