<Window x:Class="BlockSurvivalHost.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Block Survival Host" Icon="Assets/host.ico"
        Width="900" Height="720" MinWidth="620" MinHeight="480"
        Background="{StaticResource Bg}" FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <!-- header: what this is, and whether the service is up -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Source="Assets/host.ico" Width="36" Height="36" Margin="0,0,12,0" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Block Survival Host" FontSize="20" FontWeight="Black" />
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <Ellipse Width="9" Height="9" Margin="0,0,7,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource Danger}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ServiceOk}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource Online}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding ServiceText}" Style="{StaticResource MutedText}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Visibility="{Binding IsDashboard, Converter={StaticResource Visible}}">
                    <Button Content="Start all" Command="{Binding StartAllCommand}" />
                    <Button Content="Stop all" Command="{Binding StopAllCommand}" Style="{StaticResource DangerButton}" Margin="0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- the last thing that happened -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="20,8">
            <TextBlock Text="{Binding Message}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Danger}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16">
            <Grid>
                <!-- ============================== first run ============================== -->
                <StackPanel Visibility="{Binding IsFirstRun, Converter={StaticResource Visible}}" MaxWidth="560" HorizontalAlignment="Left">
                    <TextBlock Text="Set up this PC to host global worlds" FontSize="18" FontWeight="Bold" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,14"
                               Text="Players reach the worlds through the site. This PC runs them for as long as the host service runs — no domain or open TCP port needed." />

                    <Border Style="{StaticResource Card}" Visibility="{Binding IsStep1, Converter={StaticResource Visible}}">
                        <StackPanel>
                            <TextBlock Text="1 · The site" Style="{StaticResource Heading}" />
                            <TextBlock Text="Site address" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding Site, UpdateSourceTrigger=PropertyChanged}" ToolTip="https://your-site.example" />
                            <TextBlock Text="UDP ports for WebRTC (first – last)" Style="{StaticResource Label}" />
                            <StackPanel Orientation="Horizontal">
                                <TextBox Text="{Binding FirstPort, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                                <TextBlock Text="–" Margin="8,4" />
                                <TextBox Text="{Binding LastPort, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                            </StackPanel>
                            <TextBlock Text="{Binding PortsHint}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                            <CheckBox Content="Relay only: players never see this PC's address (a little more latency)" IsChecked="{Binding RelayOnly}" />
                            <CheckBox Content="Open this app in the tray when I sign in to Windows" IsChecked="{Binding StartWithWindows}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Visibility="{Binding IsStep2, Converter={StaticResource Visible}}">
                        <StackPanel>
                            <TextBlock Text="2 · The first world" Style="{StaticResource Heading}" />
                            <TextBlock Style="{StaticResource MutedText}"
                                       Text="On the site: Admin → Host PCs → Create host key. Paste its token here; the site checks it before anything is saved." />
                            <TextBlock Text="Name (only this app shows it)" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding NewWorldName, UpdateSourceTrigger=PropertyChanged}" MaxLength="32" />
                            <TextBlock Text="Host token" Style="{StaticResource Label}" />
                            <PasswordBox x:Name="WizardToken" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Visibility="{Binding IsStep3, Converter={StaticResource Visible}}">
                        <StackPanel>
                            <TextBlock Text="3 · Set up this PC" Style="{StaticResource Heading}" />
                            <TextBlock Style="{StaticResource MutedText}" Text="Windows asks for permission once, to:" />
                            <TextBlock Margin="0,6,0,0" Text="• let your account change the host's settings without asking again" />
                            <TextBlock Text="• allow the UDP ports through Windows Firewall (UDP only)" />
                            <TextBlock Text="• install the Block Survival host service, which starts with Windows and runs the worlds" />
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Back" Command="{Binding WizardBackCommand}" />
                        <Button Content="{Binding WizardNextText}" Command="{Binding WizardNextCommand}" Style="{StaticResource Primary}" />
                    </StackPanel>
                </StackPanel>

                <!-- ============================== dashboard ============================== -->
                <StackPanel Visibility="{Binding IsDashboard, Converter={StaticResource Visible}}">
                    <Border Style="{StaticResource Card}" BorderBrush="{StaticResource Danger}" Visibility="{Binding HasProblem, Converter={StaticResource Visible}}">
                        <StackPanel>
                            <TextBlock Text="The service can't read its settings" Style="{StaticResource Heading}" Foreground="{StaticResource Danger}" />
                            <TextBlock Text="{Binding Problem}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Visibility="{Binding ServiceInstalled, Converter={StaticResource InverseVisible}}">
                        <StackPanel>
                            <TextBlock Text="The host service is not installed" Style="{StaticResource Heading}" />
                            <TextBlock Style="{StaticResource MutedText}" Text="It runs the worlds in the background and starts with Windows. Windows asks for permission once." />
                            <Button Content="Set up this PC" Command="{Binding SetUpPcCommand}" Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Worlds on this PC" Style="{StaticResource Heading}" FontSize="17" />
                    <ItemsControl ItemsSource="{Binding Worlds}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                                                <Border CornerRadius="8" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#33FFFFFF" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Phase}" Value="online">
                                                                    <Setter Property="Background" Value="#446FB04A" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Phase}" Value="frozen">
                                                                    <Setter Property="Background" Value="#44E8B23A" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Phase}" Value="starting">
                                                                    <Setter Property="Background" Value="#44E8B23A" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Phase}" Value="crashed">
                                                                    <Setter Property="Background" Value="#55FF8A7A" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Phase}" Value="revoked">
                                                                    <Setter Property="Background" Value="#55FF8A7A" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Phase}" Value="error">
                                                                    <Setter Property="Background" Value="#55FF8A7A" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding PhaseText}" FontSize="11" FontWeight="Bold" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding Error}" Foreground="{StaticResource Danger}" Margin="0,4,0,0"
                                                       Visibility="{Binding HasError, Converter={StaticResource Visible}}" />
                                        </StackPanel>
                                        <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                            <Button Content="Start" Style="{StaticResource Primary}" CommandParameter="{Binding}"
                                                    Command="{Binding DataContext.StartCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            <Button Content="Restart" CommandParameter="{Binding}" ToolTip="Players stay paused while it restarts"
                                                    Command="{Binding DataContext.RestartCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            <Button Content="Stop" CommandParameter="{Binding}" ToolTip="Saves, then the world is offline until you start it"
                                                    Command="{Binding DataContext.StopCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            <Button Content="Log" Click="OnOpenLog" />
                                            <Button Content="Remove" Style="{StaticResource DangerButton}" CommandParameter="{Binding}" Margin="0"
                                                    Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        </WrapPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="Add a world" Style="{StaticResource Heading}" />
                                <TextBlock Style="{StaticResource MutedText}" Text="Create a host key on the site (Admin → Host PCs) and paste its token." />
                                <TextBlock Text="Name" Style="{StaticResource Label}" />
                                <TextBox Text="{Binding NewWorldName, UpdateSourceTrigger=PropertyChanged}" MaxLength="32" />
                                <TextBlock Text="Host token" Style="{StaticResource Label}" />
                                <PasswordBox x:Name="AddToken" />
                                <CheckBox Content="Start it with the service" IsChecked="{Binding NewWorldAutoStart}" />
                                <Button Content="Check and add" Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0,12,0,0" Click="OnAddWorld" x:Name="AddButton" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="Settings" Style="{StaticResource Heading}" />
                                <TextBlock Text="Site address" Style="{StaticResource Label}" />
                                <TextBox Text="{Binding Site, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="UDP ports (first – last)" Style="{StaticResource Label}" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBox Text="{Binding FirstPort, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                                    <TextBlock Text="–" Margin="8,4" />
                                    <TextBox Text="{Binding LastPort, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                                </StackPanel>
                                <TextBlock Text="{Binding PortsHint}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                                <CheckBox Content="Relay only (hide this PC's address)" IsChecked="{Binding RelayOnly}" />
                                <CheckBox Content="Open in the tray when I sign in" IsChecked="{Binding StartWithWindows}" />
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="Save settings" Command="{Binding SaveSettingsCommand}" Style="{StaticResource Primary}" />
                                    <Button Content="Repair setup" Command="{Binding SetUpPcCommand}" ToolTip="Firewall rule, permissions and service, again (asks for permission)" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
