# Block Survival — .env for one environment on the cPanel account.
#
#   cp deploy/.env.cpanel.example ~/<env>/app/.env && chmod 600 ~/<env>/app/.env
#   php artisan key:generate            # fills APP_KEY in place
#
# Fill in every line marked <...>. Everything else is a decision recorded in
# docs/cpanel-go-live.md (§4.7) and should stay as written. This file is never
# committed and never written by the deploy script.

APP_NAME="Block Survival"
APP_ENV=<staging|production>
APP_KEY=
APP_DEBUG=false
APP_URL=https://<hostname>

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# true = every request gets a 503 "down for maintenance" (except /up). Also set by `php artisan down`.
APP_MAINTENANCE_MODE=false
# shown in the maintenance page footer; leave empty to hide the contact line
APP_SUPPORT_EMAIL=

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# SQLite, one file per environment, OUTSIDE the git tree (§4.4). Absolute path.
# Name it after the app: $HOME/<env>/data/ is shared with the other apps on the
# account, and a generic database.sqlite will collide with theirs.
DB_CONNECTION=sqlite
DB_DATABASE=/home/<cpanel-user>/<staging|production>/data/block-survival.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

# no queue worker on shared hosting; nothing in the app dispatches jobs (§0)
QUEUE_CONNECTION=sync
CACHE_STORE=database
FILESYSTEM_DISK=local

# Reverb cannot run on shared cPanel (§0, §3.1). Until the polling signaller
# lands, broadcasting is off; multiplayer rooms will not connect.
BROADCAST_CONNECTION=null

# the app sends no mail; keep it in the log
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@<hostname>"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
