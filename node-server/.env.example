# Node
TZ=UTC
PORT=4000
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
# generate one with `node ace generate:key`
APP_KEY=
APP_URL=http://${HOST}:${PORT}
APP_TIMEZONE=UTC
APP_MAINTENANCE_MODE=false

# Session
SESSION_DRIVER=cookie

# Database (SQLite; default tmp/db.sqlite3)
# DB_DATABASE=tmp/db.sqlite3

# Admin account, created/updated by `node ace admin:sync`
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin
