<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Framework Material theme (no AppCompat/Material dependency needed): the
         UI itself is Jetpack Compose; this just gives the Activity a windowed,
         action-bar-free host. -->
    <style name="Theme.BlockSurvival" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
    </style>
</resources>
